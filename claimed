local function getInventory()
    local ok, res = pcall(function()
        return CommF:InvokeServer("getInventory")
    end)
    if not ok then return nil end
    return res or {}
end

local function buildSnapshot()
    local inv = getInventory()
    if not inv then return nil end

    local map = {}
    for _, item in pairs(inv) do
        if item.Type == "Blox Fruit" or item.Type == "Premium" then
            local name = item.Name or item.DisplayName or "Unknown"
            map[name] = {
                DisplayName = item.DisplayName or name,
                Count = item.Count or 1,
            }
        end
    end
    return map
end

local function diff(oldMap, newMap)
    local received, lost = {}, {}

    for name, info in pairs(newMap) do
        local old = (oldMap[name] and oldMap[name].Count) or 0
        local d = info.Count - old
        if d > 0 then
            table.insert(received, { DisplayName = info.DisplayName, Amount = d })
        end
    end

    for name, info in pairs(oldMap) do
        local new = (newMap[name] and newMap[name].Count) or 0
        local d = info.Count - new
        if d > 0 then
            table.insert(lost, { DisplayName = info.DisplayName, Amount = d })
        end
    end

    return received, lost
end

local function formatDiff(received, lost)
    local lines = {}
    for _, v in ipairs(received) do
        table.insert(lines, string.format("📥 **%s** — %dx", v.DisplayName, v.Amount))
    end
    for _, v in ipairs(lost) do
        table.insert(lines, string.format("📤 **%s** — %dx", v.DisplayName, v.Amount))
    end
    return table.concat(lines, "\n")
end

local function flushSession()
    if finalized then return end
    finalized = true
    if isSending then return end
    isSending = true

    if #tradeQueue == 0 then
        isSending = false
        return
    end

    local chunks = {}
    local current = {}
    local currentLen = 0

    for _, entry in ipairs(tradeQueue) do
        local line = string.format("[%s] %s", entry.time, entry.summary)
        if currentLen + #line + 1 > 950 then
            table.insert(chunks, table.concat(current, "\n"))
            current = {}
            currentLen = 0
        end
        table.insert(current, line)
        currentLen = currentLen + #line + 1
    end

    if #current > 0 then
        table.insert(chunks, table.concat(current, "\n"))
    end

    local totalTrades = #tradeQueue
    local duration = os.time() - sessionStart

    local embeds = {}

    table.insert(embeds, {
        title = "Session Ended — " .. lp.Name,
        color = 0x00FF88,
        fields = {
            { name = "👤 User", value = string.format("%s (%s)", lp.Name, lp.DisplayName), inline = true },
            { name = "📊 Total Trades", value = tostring(totalTrades), inline = true },
            { name = "⏱️ Duration", value = string.format("%dm %ds", math.floor(duration / 60), duration % 60), inline = true },
        },
        footer = { text = "Session logger" },
        timestamp = DateTime.now():ToIsoDate(),
    })

    for i, chunk in ipairs(chunks) do
        table.insert(embeds, {
            title = "Trade Log (" .. i .. "/" .. #chunks .. ")",
            color = 0x00CCFF,
            description = "```\n" .. chunk .. "\n```",
            timestamp = DateTime.now():ToIsoDate(),
        })
    end

    local ok = pcall(function()
        httpRequest({
            Url = WEBHOOK,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                username = "Session Trade Logger",
                embeds = embeds,
                allowed_mentions = { parse = {} },
            }),
        })
    end)

    if not ok and #chunks > 1 then
        for _, chunk in ipairs(chunks) do
            pcall(function()
                httpRequest({
                    Url = WEBHOOK,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode({
                        username = "Session Trade Logger",
                        embeds = {{
                            title = "Trade Log — " .. lp.Name,
                            color = 0x00CCFF,
                            description = "```\n" .. chunk .. "\n```",
                            timestamp = DateTime.now():ToIsoDate(),
                        }},
                        allowed_mentions = { parse = {} },
                    }),
                })
            end)
            task.wait(0.5)
        end
    end

    isSending = false
end

local function onTradeClose()
    task.wait(1.5)
    if tradeOpen then return end

    local after = buildSnapshot()
    if not after or not beforeSnapshot then
        beforeSnapshot = after
        return
    end

    local received, lost = diff(beforeSnapshot, after)
    beforeSnapshot = after

    if #received == 0 and #lost == 0 then return end

    local summary = formatDiff(received, lost)
    if summary == lastSummary then return end
    lastSummary = summary

    table.insert(tradeQueue, {
        time = os.date("%H:%M:%S"),
        summary = summary,
    })
end

local function startWatcher()
    local pgInner = lp:WaitForChild("PlayerGui", 60)
    if not pgInner then return end
    local main = pgInner:WaitForChild("Main", 60)
    if not main then return end
    local tradeGui = main:WaitForChild("Trade", 60)
    if not tradeGui then return end

    tradeGui:GetPropertyChangedSignal("Visible"):Connect(function()
        if tradeGui.Visible then
            tradeOpen = true
            task.wait(0.3)
            beforeSnapshot = buildSnapshot()
        else
            if tradeOpen then
                tradeOpen = false
                task.spawn(onTradeClose)
            end
        end
    end)
end

