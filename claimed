local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local lp = Players.LocalPlayer

local httpRequest = (syn and syn.request)
    or (http and http.request)
    or http_request
    or request
    or httprequest
    or (fluxus and fluxus.request)

local WEBHOOK = "https://discord.com/api/webhooks/1561336496814948455/8OTM2WDhxhW_4Xgv19Q_DLCTad2x5btW4YneLBcyUJUFTAt-dNrDaen7766l7Co7AIt6"

local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
local TradeFunction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TradeFunction")

local trackedItems = {}
local sentHistory = {}
local lastSnapshot = {}

local function getInventory()
    local ok, res = pcall(function()
        return CommF:InvokeServer("getInventory")
    end)
    if not ok then return {} end
    return res or {}
end

local function buildSnapshot()
    local inv = getInventory()
    local map = {}

    for _, item in pairs(inv) do
        if item.Type == "Blox Fruit" or item.Type == "Premium" then
            local name = item.Name or item.DisplayName or "Unknown"
            map[name] = {
                Name = name,
                DisplayName = item.DisplayName or name,
                Count = item.Count or 1,
                Type = item.Type,
                Rarity = item.Rarity or 0,
            }
        end
    end

    return map
end

local function sendToWebhook(receivedItems, lostItems)
    if not httpRequest then return end

    local fields = {}

    if #receivedItems > 0 then
        local lines = {}
        for _, v in ipairs(receivedItems) do
            table.insert(lines, string.format("**%s** — %dx", v.DisplayName, v.Amount))
        end
        table.insert(fields, {
            name = "📥 Received Items",
            value = table.concat(lines, "\n"),
            inline = false,
        })
    end

    if #lostItems > 0 then
        local lines = {}
        for _, v in ipairs(lostItems) do
            table.insert(lines, string.format("**%s** — %dx", v.DisplayName, v.Amount))
        end
        table.insert(fields, {
            name = "📤 Removed Items",
            value = table.concat(lines, "\n"),
            inline = false,
        })
    end

    if #fields == 0 then return end

    local totalCount = 0
    for _, v in ipairs(receivedItems) do
        totalCount = totalCount + v.Amount
    end
    for _, v in ipairs(lostItems) do
        totalCount = totalCount + v.Amount
    end

    local embed = {
        title = "Trade Update — " .. lp.Name,
        color = 0x00FF88,
        fields = fields,
        footer = {
            text = string.format("User: %s | Display: %s | Total changes: %d", lp.Name, lp.DisplayName, totalCount),
        },
        timestamp = DateTime.now():ToIsoDate(),
    }

    local payload = {
        username = "Trade Logger",
        embeds = { embed },
    }

    pcall(function()
        httpRequest({
            Url = WEBHOOK,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
    end)
end

local function diffSnapshots(oldMap, newMap)
    local received = {}
    local lost = {}

    for name, info in pairs(newMap) do
        local oldCount = oldMap[name] and oldMap[name].Count or 0
        local diff = info.Count - oldCount

        if diff > 0 then
            table.insert(received, {
                DisplayName = info.DisplayName,
                Amount = diff,
            })
        end
    end

    for name, info in pairs(oldMap) do
        local newCount = newMap[name] and newMap[name].Count or 0
        local diff = info.Count - newCount

        if diff > 0 then
            table.insert(lost, {
                DisplayName = info.DisplayName,
                Amount = diff,
            })
        end
    end

    return received, lost
end

local function trackOnce()
    local newMap = buildSnapshot()

    if next(lastSnapshot) ~= nil then
        local received, lost = diffSnapshots(lastSnapshot, newMap)
        if #received > 0 or #lost > 0 then
            sendToWebhook(received, lost)
        end
    end

    lastSnapshot = newMap
end

task.spawn(function()
    lastSnapshot = buildSnapshot()

    while true do
        task.wait(1.5)
        pcall(trackOnce)
    end
end)

pcall(function()
    local pg = lp:WaitForChild("PlayerGui")
    local main = pg:WaitForChild("Main", 10)
    if not main then return end
    local tradeGui = main:WaitForChild("Trade", 10)
    if not tradeGui then return end

    tradeGui:GetPropertyChangedSignal("Visible"):Connect(function()
        if tradeGui.Visible then
            lastSnapshot = buildSnapshot()
        else
            task.wait(1)
            trackOnce()
        end
    end)
end)

TradeFunction.OnClientInvoke = TradeFunction.OnClientInvoke
